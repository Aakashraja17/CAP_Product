{
  "name": "CAPM_1",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@sap/cds": "^10.1.1"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "cds-plugin-ui5": "^0.17.4",
    "mbt": "^1.2.49",
    "rimraf": "^5.0.5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-ui_cat": "cds watch --open com.capm.ui.uicat/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy CAPM_1 --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1",
    "watch-project1": "cds watch --open com.capm.ui1.project1/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ]
}
